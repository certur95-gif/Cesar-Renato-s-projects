<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="es-ES" page-range-format="minimal" demote-non-dropping-particle="sort-only">
  <info>
    <title>Vancouver - UNAP (parentesis en superindice)</title>
    <title-short>Vancouver UNAP sup()</title-short>
    <id>http://www.zotero.org/styles/vancouver-unap-iquitos-sup-parentesis</id>
    <link href="http://www.zotero.org/styles/vancouver-unap-iquitos-sup-parentesis" rel="self"/>
    <link href="http://www.zotero.org/styles/vancouver" rel="template"/>
    <link href="https://enlinea.unapiquitos.edu.pe/gobierno/vicerrectorado_investigacion/descargas/RV-001-2018-VRINV-UNAP_Guia-para-la-elaboracion-de-plan-de-tesis-UNAP.pdf" rel="documentation"/>
    <category citation-format="numeric"/>
    <category field="medicine"/>
    <category field="biology"/>
    <summary>Estilo Vancouver (NLM/ICMJE) ajustado a la Guia para la elaboracion de plan e informe de tesis de la UNAP (RV N 001-2018-VRINV-UNAP): numeracion entre parentesis y en superindice por orden de aparicion en el texto, autores como apellido + iniciales sin puntos, hasta 6 autores y luego et al., titulo de revista abreviado, paginacion abreviada, terminos en espanol (En:, editores, citado, Disponible en:).</summary>
    <published>2026-09-18T00:00:00+00:00</published>
    <updated>2026-09-18T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="es">
    <terms>
      <term name="accessed">citado</term>
      <term name="cited">citado</term>
      <term name="available at">Disponible en</term>
      <term name="internet">Internet</term>
      <term name="in">En</term>
      <term name="no date" form="short">s.f.</term>
      <term name="anonymous" form="short">anon.</term>
      <term name="edition" form="short">ed.</term>
      <term name="page" form="short">p.</term>
      <term name="forthcoming">en prensa</term>
      <term name="in press">en prensa</term>
      <term name="presented at">presentado en</term>
      <term name="editor" form="short">
        <single>editor</single>
        <multiple>editores</multiple>
      </term>
      <term name="translator" form="short">
        <single>traductor</single>
        <multiple>traductores</multiple>
      </term>
      <term name="container-author" form="short">
        <single>autor</single>
        <multiple>autores</multiple>
      </term>
    </terms>
  </locale>
  <!-- ============ AUTORES ============ -->
  <macro name="author">
    <names variable="author">
      <name initialize-with="" name-as-sort-order="all" sort-separator=" " delimiter=", "/>
      <label form="short" prefix=", "/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
      </substitute>
    </names>
  </macro>
  <macro name="editor">
    <names variable="editor">
      <name initialize-with="" name-as-sort-order="all" sort-separator=" " delimiter=", "/>
      <label form="short" prefix=", "/>
    </names>
  </macro>
  <!-- ============ TITULO Y SOPORTE ============ -->
  <macro name="medium">
    <choose>
      <if type="webpage post post-weblog dataset report thesis" match="any">
        <choose>
          <if variable="URL">
            <text term="internet" text-case="capitalize-first" prefix="[" suffix="]"/>
          </if>
        </choose>
      </if>
      <else-if type="article-journal article-magazine article-newspaper review review-book" match="any">
        <choose>
          <if variable="volume page DOI" match="none">
            <choose>
              <if variable="URL">
                <text term="internet" text-case="capitalize-first" prefix="[" suffix="]"/>
              </if>
            </choose>
          </if>
        </choose>
      </else-if>
    </choose>
  </macro>
  <macro name="genre">
    <choose>
      <if type="thesis report paper-conference speech" match="any">
        <text variable="genre" prefix="[" suffix="]"/>
      </if>
    </choose>
  </macro>
  <macro name="title">
    <group delimiter=" ">
      <text variable="title"/>
      <text macro="genre"/>
      <text macro="medium"/>
    </group>
  </macro>
  <!-- ============ FUENTE ============ -->
  <macro name="container">
    <choose>
      <if type="article-journal article-magazine article-newspaper review review-book" match="any">
        <text variable="container-title" form="short" strip-periods="true"/>
      </if>
      <else-if type="chapter entry entry-dictionary entry-encyclopedia paper-conference" match="any">
        <group delimiter=" ">
          <text term="in" text-case="capitalize-first" suffix=":"/>
          <group delimiter=". ">
            <text macro="editor"/>
            <text variable="container-title"/>
          </group>
        </group>
      </else-if>
      <else>
        <text variable="container-title"/>
      </else>
    </choose>
  </macro>
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>
  <macro name="publisher">
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>
  <!-- ============ FECHAS ============ -->
  <macro name="date">
    <choose>
      <if type="article-journal article-magazine article-newspaper review review-book" match="any">
        <date variable="issued" delimiter=" ">
          <date-part name="year"/>
          <date-part name="month" form="short" strip-periods="true"/>
          <date-part name="day"/>
        </date>
      </if>
      <else>
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </else>
    </choose>
  </macro>
  <macro name="accessed">
    <choose>
      <if variable="DOI" match="none">
        <group prefix="[" suffix="]" delimiter=" ">
          <text term="cited"/>
          <date variable="accessed" form="text"/>
        </group>
      </if>
    </choose>
  </macro>
  <!-- ============ LOCALIZADORES ============ -->
  <macro name="locators">
    <choose>
      <if type="article-journal article-magazine review review-book" match="any">
        <group delimiter=":">
          <group>
            <text variable="volume"/>
            <text variable="issue" prefix="(" suffix=")"/>
          </group>
          <text variable="page"/>
        </group>
      </if>
      <else-if type="article-newspaper">
        <group delimiter=":">
          <text variable="section"/>
          <text variable="page"/>
        </group>
      </else-if>
      <else-if type="chapter entry entry-dictionary entry-encyclopedia paper-conference" match="any">
        <group delimiter=" ">
          <label variable="page" form="short"/>
          <text variable="page"/>
        </group>
      </else-if>
      <else-if type="bill legislation legal_case patent treaty" match="any">
        <text variable="number"/>
      </else-if>
    </choose>
  </macro>
  <!-- ============ IDENTIFICADORES ============ -->
  <macro name="doi">
    <text variable="DOI" prefix="doi: "/>
  </macro>
  <macro name="url">
    <choose>
      <if variable="DOI" match="none">
        <group delimiter=": ">
          <text term="available at" text-case="capitalize-first"/>
          <text variable="URL"/>
        </group>
      </if>
    </choose>
  </macro>
  <!-- ============ CITA EN EL TEXTO: numero entre parentesis, en superindice ============ -->
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="," vertical-align="sup">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <!-- ============ REFERENCIAS BIBLIOGRAFICAS ============ -->
  <bibliography entry-spacing="0" line-spacing="1" second-field-align="flush" et-al-min="7" et-al-use-first="6">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout>
      <text variable="citation-number" suffix=". "/>
      <choose>
        <if type="article-journal article-magazine article-newspaper review review-book" match="any">
          <group delimiter=". " suffix=".">
            <text macro="author"/>
            <text macro="title"/>
            <text macro="container"/>
            <group>
              <text macro="date"/>
              <text macro="locators" prefix=";"/>
              <text macro="accessed" prefix=" "/>
            </group>
          </group>
        </if>
        <else-if type="chapter entry entry-dictionary entry-encyclopedia paper-conference" match="any">
          <group delimiter=". " suffix=".">
            <text macro="author"/>
            <text macro="title"/>
            <text macro="container"/>
            <text macro="edition"/>
            <group>
              <text macro="publisher"/>
              <text macro="date" prefix="; "/>
              <text macro="accessed" prefix=" "/>
            </group>
            <text macro="locators"/>
          </group>
        </else-if>
        <else>
          <group delimiter=". " suffix=".">
            <text macro="author"/>
            <text macro="title"/>
            <text macro="container"/>
            <text macro="edition"/>
            <group>
              <text macro="publisher"/>
              <text macro="date" prefix="; "/>
              <text macro="accessed" prefix=" "/>
            </group>
            <text macro="locators"/>
          </group>
        </else>
      </choose>
      <group prefix=" " delimiter=" " suffix=".">
        <text macro="url"/>
        <text macro="doi"/>
      </group>
    </layout>
  </bibliography>
</style>
